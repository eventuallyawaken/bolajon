# Database URL (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bolajon_erp?schema=public"

# Server Port & Environment
PORT=5000
NODE_ENV="production"

# Allowed Frontend Origins (comma-separated)
CORS_ORIGIN="https://app.bolajon.uz"

# Strong Random JWT Secrets (generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET="replace_with_strong_random_secret_min_32_chars"
JWT_ACCESS_EXPIRES_IN="1d"

JWT_REFRESH_SECRET="replace_with_strong_random_refresh_secret_min_32_chars"
JWT_REFRESH_EXPIRES_IN="1d"

IMPERSONATION_SECRET="replace_with_strong_random_impersonation_secret"
